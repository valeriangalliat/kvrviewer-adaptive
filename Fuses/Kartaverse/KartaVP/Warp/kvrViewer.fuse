-- Edit/Reload ButtonControl code by Kristof Indeherberge
ActionEditScript = [[
	-- Force-open the Fusion native "Edit Fuse" API functionality
	tool.ScriptEdit[fu.TIME_UNDEFINED] = 1
	print('[kvrViewer] Script Editor Opened')

	-- Unpress the "Script Edit" button
	tool.ScriptEdit[fu.TIME_UNDEFINED] = 0
]]

ActionReloadScript = [[
	-- Force-run the Fusion native "Reload Fuse" API functionality
	tool.ScriptReload[fu.TIME_UNDEFINED] = 1
	print("[kvrViewer] Fuse Reloaded")

	-- Unpress the "Script Reload" button
	tool.ScriptReload[fu.TIME_UNDEFINED] = 0
]]

function Create()
	InLabel = self:AddInput(BrandLogo, "Label",{
		LINKID_DataType = "Text",
		INPID_InputControl = "LabelControl",
		LBLC_MultiLine = true,
		INP_External = false,
		INP_Passive = true,
		IC_ControlPage = -1,
		IC_NoLabel = true,
		IC_NoReset = true,
	})
	InReset = self:AddInput("InReset", "InReset",{
		LINKID_DataType = "Number",
		INPID_InputControl = "ButtonControl",
		INP_Default = 0,
		INP_DoNotifyChanged = true,
		INP_Integer = true,
		IC_Visible = false,
	})
	self:BeginControlNest("View Transforms", "Transforms", true, {})
	InCenter = self:AddInput("Center", "Center", {
		LINKID_DataType = "Point",
		INPID_InputControl = "OffsetControl",
		INPID_PreviewControl = "CrosshairControl",
		CHC_Style = "NormalCross",
--		OFCD_DisplayXScale = 380,
--		OFCD_DisplayYScale = 180,
--		PCD_OffsetX = 0.5,
--		PCD_OffsetY = 0.5,
--		INP_DefaultX = 0,
--		INP_DefaultY = 0,
		INP_DoNotifyChanged = true,
	})
	InAngle = self:AddInput("Angle", "Angle", {
		LINKID_DataType = "Number", 
		INPID_InputControl = "ScrewControl",
		INPID_PreviewControl = "AngleControl",
		INP_MinScale = -180.0,
		INP_MaxScale = 180,
		INP_Default = 0.0,
--		PCD_OffsetX = 0.5,
--		PCD_OffsetY = 0.5,
		ACID_Center = "Center",
--		ACID_Radius = "Zoom",
--		PC_GrabPriority = 1,
	})
	InZoom = self:AddInput("Long-Edge Zoom", "Zoom",{
		LINKID_DataType = "Number",
		INPID_InputControl = "ScrewControl",
--		INPID_InputControl = "SliderControl",
		INPID_PreviewControl = "EllipseControl",
		INP_MinScale = 0.01,
		INP_MaxScale = 5.0,
		INP_MinAllowed = 0.01,
		INP_MaxAllowed = 5.0,
		INP_Default = 0.5,
		ICD_Center = 0.5, -- this sets the default value to the center of the slider
		ECID_Center = "Center",
		ECID_Angle = "Angle",
		EC_GiveRadius = true,
		PC_ControlGroup = 1.0,
		PC_ControlID = 0,
	})
	self:EndControlNest()
	self:BeginControlNest("Projection", "Projection", true, {})
		InImageProjection = self:AddInput("Image Projection", "ImageProjection", {
			INPID_InputControl = "ComboControl",
			INP_DoNotifyChanged = true,
			INP_Integer = true,
			ICD_Width = 1,
			CC_LabelPosition = "Horizontal",
			{CCS_AddString = "Flat"},
			{CCS_AddString = "360VR"},
			{CCS_AddString = "180VR"},
			{CCS_AddString = "Fisheye"},
			--{CCS_AddString = "Tiled Grid"},
			INP_Default = 1,
		})
		InFieldOfView = self:AddInput("Diagonal Field of View", "FieldOfView",{
			LINKID_DataType = "Number",
			INPID_InputControl = "SliderControl",
			INP_MinScale = 45.0,
			INP_MaxScale = 360.0,
			INP_Default = 180.0,
		})
		InDomeTiltAngle = self:AddInput("Dome Tilt Angle", "DomeTiltAngle", {
			LINKID_DataType = "Number", 
			INPID_InputControl = "SliderControl",
			INP_MinScale = -90,
			INP_MaxScale = 90,
			INP_Default = 0.0,
		})
		InTinyPlanet = self:AddInput("Tiny Planet", "TinyPlanet",{
			LINKID_DataType = "Number",
			INPID_InputControl = "CheckboxControl",
			INP_Default = 1.0,
		})
	self:EndControlNest()
	self:BeginControlNest("Stereo", "StereoNest", true, {})
		InInputStereo = self:AddInput("Mode", "InputStereo",{
			LINKID_DataType = "Number",
			INPID_InputControl = "MultiButtonControl",
			-- MBTNC_ForceButtons = true,
			MBTNC_StretchToFit = true,
			INP_Default = 0,
			INP_Integer = true,
			{MBTNC_AddButton = "Mono"},
			{MBTNC_AddButton = "Dual In"},
			{MBTNC_AddButton = "Horiz"},
			{MBTNC_AddButton = "Vert"},
			INP_DoNotifyChanged = true,
		})
		InConvergence = self:AddInput("Convergence", "Convergence", {
			LINKID_DataType = "Number", 
			INPID_InputControl = "ScrewControl",
			INP_MinScale = -1.0,
			INP_MaxScale = 1,
			INP_Default = 0.0,
		})
		InSwapEyes = self:AddInput("Swap Eyes", "SwapEyes",{
			LINKID_DataType = "Number",
			INPID_InputControl = "CheckboxControl",
			INP_Default = 0,
		})
		InAnaglyph = self:AddInput("Anaglyph", "Anaglyph",{
			LINKID_DataType = "Number",
			INPID_InputControl = "CheckboxControl",
			INP_Default = 0,
		})
		InOutputSTMap = self:AddInput("Output ST Map", "OutputSTMap",{
			LINKID_DataType = "Number",
			INPID_InputControl = "CheckboxControl",
			INP_Default = 0,
			IC_Visible = false,
		})
		InSolidAlpha = self:AddInput("Solid Alpha", "SolidAlpha", {
			INPID_InputControl = "CheckboxControl",
			INP_Default = 0.0,
			INP_DoNotifyChanged = true,
			INP_External = false,
			INP_Integer = true,
			INP_Passive = false,
		})
	self:EndControlNest()
	self:BeginControlNest("Image", "ImageNest", true, {})
		InOutputFormat = self:AddInput("Output Resolution", "OutputFormat", {
			LINKID_DataType = "Number",
			INPID_InputControl = "ComboControl",
			INP_DoNotifyChanged = true,
			INP_Default = 0,
			INP_Integer = true,
			ICD_Width = 1,
			{CCS_AddString = "1080p Landscape (1920 x 1080)"},
			{CCS_AddString = "1080p Portrait (1080 x 1920)"},
			{CCS_AddString = "Custom"},
		})
		InWidth = self:AddInput("Width", "Width", {
			LINKID_DataType = "Text",
			INPID_InputControl = "TextEditControl",
			INPS_DefaultText = "1920",
			TEC_Lines = 1,
			TEC_CharLimit = 5,
			INP_External = false,
			IC_Visible = false,
		})
		InHeight = self:AddInput("Height", "Height", {
			LINKID_DataType = "Text",
			INPID_InputControl = "TextEditControl",
			INPS_DefaultText = "1080",
			TEC_Lines = 1,
			TEC_CharLimit = 5,
			INP_External = false,
			IC_Visible = false,
		})
	self:EndControlNest()
	-- Circular Fisheye Masking
	self:BeginControlNest("Masking", "MaskingNest", false, {})
		InCircularMaskCenter = self:AddInput("Circular Mask Center", "CircularMaskCenter", {
			LINKID_DataType = "Point",
			--INPID_InputControl = "OffsetControl",
			--INPID_PreviewControl = "CrosshairControl",
			INP_DoNotifyChanged = true,
		})
		InCircularMaskDiameter = self:AddInput("Mask Diameter", "CircularMaskDiameter", {
			LINKID_DataType = "Number",
			INPID_InputControl  = "SliderControl",
			INP_MinScale = 0.0,
			INP_MaxScale = 2.0,
			INP_Default = 1.0,
		})
		InCircularMaskSoftness = self:AddInput("Mask Softness", "CircularMaskSoftness",{
			LINKID_DataType = "Number",
			INPID_InputControl = "SliderControl",
			INP_MinScale = 0.0,
			INP_MaxScale = 1.0,
			INP_Default = 0.0,
			---INP_Default = 0.025,
		})
	self:EndControlNest()
	self:BeginControlNest("Edge Settings", "EdgeSettings", false, {})
		InEdges = self:AddInput("Edges", "Edges",{
			LINKID_DataType = "Number",
			INPID_InputControl = "MultiButtonControl",
			INP_Default = 2,
			INP_Integer = true,
			INP_DoNotifyChanged = true,
			INP_MinScale = 0,
			INP_MaxScale = 3,
			INP_MinAllowed = 0,
			INP_MaxAllowed = 3,
			{MBTNC_AddButton = "Canvas",},
			{MBTNC_AddButton = "Wrap",},
			{MBTNC_AddButton = "Duplicate",},
			{MBTNC_AddButton = "Mirror",},
		})
	self:EndControlNest()
	self:BeginControlNest("Edit Code", "EditNest", true, {ICS_ControlPage = "Common"})
		BtnEditScript = self:AddInput("Edit Fuse", "EditScript", {
			INPID_InputControl = "ButtonControl",
			ICS_ControlPage = "Common",
			INP_External = false,
			IC_Visible = true,
			BTNCS_Execute = ActionEditScript,
			ICD_Width = 0.5,
		})
		BtnReloadFunction = self:AddInput("Reload Fuse", "ReloadScript",{
			INPID_InputControl = "ButtonControl",
			ICS_ControlPage = "Common",
			INP_External = false,
			IC_Visible = true,
			BTNCS_Execute = ActionReloadScript,
			ICD_Width = 0.5,
		})
	self:EndControlNest()
	InImage1 = self:AddInput("Image1", "Image1",{
		LINKID_DataType = "Image",
		LINK_Main = 1,
		INP_AcceptsGPUImages = true,
	})
	InImage2 = self:AddInput("Image2", "Image2",{
		LINKID_DataType = "Image",
		LINK_Main = 2,
		INP_Required = false,
		INP_AcceptsGPUImages = true,
	})
	OutImage1 = self:AddOutput("Output1", "Output1",{
		LINKID_DataType = "Image",
		LINK_Main = 1,
	})
	OutImage2 = self:AddOutput("Output2", "Output2",{
		LINKID_DataType = "Image",
		LINK_Main = 2,
	})
end

function NotifyChanged(inp, param, time)
	--[[
		Handles all input control events.

		:param inp: Input that triggered a signal.
		:type inp: Input

		:param param: Parameter object holding the (new) value.
		:type param: Parameter

		:param time: Current frame number.
		:type time: float
	]]
	if inp == InOutputFormat then
		InWidth:SetAttrs({IC_Visible = param.Value == 2})
		InHeight:SetAttrs({IC_Visible = param.Value == 2})
	elseif inp == InInputStereo then
		local visible1
		local visible2
		if param.Value == 1.0 then visible1 = true else visible1 = false end
		InImage2:SetAttrs({LINK_Visible = visible1})

		--if param.Value == 0.0 or param.Value == 1.0 then visible2 = true else visible2 = false end
		--InOutputSTMap:SetAttrs({IC_Visible = visible2})
		
		if param.Value == 2.0 or param.Value == 3.0 then visible2 = true else visible2 = false end
		InSolidAlpha:SetAttrs({IC_Visible = visible2})
	elseif inp == InImageProjection then
		local visible1
		if (param.Value == 1.0 or param.Value == 2.0) then visible1 = true else visible1 = false end
		-- Show Tiny Planet options on 360VR and 180VR image projections
		InTinyPlanet:SetAttrs({IC_Visible = visible1})

		-- Hide the view transform controls on a flat image projections
		local visible2
		if param.Value ~= 0.0 then visible2 = true else visible2 = false end
		InCenter:SetAttrs({IC_Visible = visible2})
		InAngle:SetAttrs({IC_Visible = visible2})

		-- Show the zoom control on 360VR and 180VR content
		if (param.Value == 1.0 or param.Value == 2.0) then visible2 = true else visible2 = false end
		InZoom:SetAttrs({IC_Visible = visible2})
		
		-- Show the masking controls on fisheye image projections
		local visible3
		if param.Value == 3.0 then visible3 = true else visible3 = false end
		InCircularMaskCenter:SetAttrs({IC_Visible = visible3})
		InCircularMaskDiameter:SetAttrs({IC_Visible = visible3})
		InCircularMaskSoftness:SetAttrs({IC_Visible = visible3})

		-- Show field of view control and the dome tilt angle control on fisheye image projections
		local visible4
		if param.Value == 3.0 then visible4 = true else visible4 = false end
		InFieldOfView:SetAttrs({IC_Visible = visible4})
		-- InDomeTiltAngle:SetAttrs({IC_Visible = visible4})
		
		-- Hide the Convergence control on flat images
		if param.Value ~= 0.0 then visible5 = true else visible5 = false end
		InConvergence:SetAttrs({IC_Visible = visible5})
	end
end

local lastreqtime = -2

local function outputSize(req)
	local format = InOutputFormat:GetValue(req).Value
	local w, h
	if format == 0 then
		w, h = 1920, 1080
	elseif format == 1 then
		w, h = 1080, 1920
	else
		assert(format == 2, "kvrViewer Adaptive: invalid output preset")
		w = tonumber(InWidth:GetValue(req).Value)
		h = tonumber(InHeight:GetValue(req).Value)
		assert(w and h and w >= 1 and h >= 1 and w <= 16384 and h <= 16384
			and w % 1 == 0 and h % 1 == 0,
			"kvrViewer Adaptive: custom Width and Height must be whole pixels from 1 to 16384")
	end
	return w, h
end

local function longEdgeZoom(zoom, width, height)
	return zoom / math.min(1, width / height)
end

function processEye(req, img, eye)
	local w, h = outputSize(req)

	local inputStereo = InInputStereo:GetValue(req).Value 
	local converge = InConvergence:GetValue(req).Value * eye
	--local fov = (1.01 - InZoom:GetValue(req).Value) * 2.0
	local fov = InZoom:GetValue(req).Value
	local domeTiltAngle = InDomeTiltAngle:GetValue(req).Value
	local pitch = ((((InCenter:GetValue(req).Y - 0.5) * 180) + domeTiltAngle) * -1) / (180.0 / math.pi)
	local yaw = ((((InCenter:GetValue(req).X - 0.5) * 360) - 90) * (math.pi / 180.0)) + converge
	local roll = (InAngle:GetValue(req).Value * -1.0) * (math.pi / 180.0)

	local solidAlpha = InSolidAlpha:GetValue(req).Value

	local tinyPlanet = InTinyPlanet:GetValue(req).Value
	local imageProjection = InImageProjection:GetValue(req).Value
	local projectionName
	if imageProjection == 1 or imageProjection == 2 then
		fov = longEdgeZoom(fov, w, h)
	end

	local src = img
	local dst

	if imageProjection == 0 then
		dst = Image{
			IMG_Like = src,
			IMG_Depth = IMDP_128bitFloat,
			IMG_DeferAlloc = true
		}
	else
		dst = Image({
			IMG_Like = src,
			IMG_Width = w,
			IMG_Height = h,
			IMG_DataWindow = ImgRectI(0, 0, w, h),
			IMAT_OriginalWidth = w,
			IMAT_OriginalHeight = h,
			IMG_NoData = req:IsPreCalc()
		})
	end

	local reset = InReset:GetValue(req).Value
	local edges = InEdges:GetValue(req).Value

	local width = dst.Width
	local height = dst.Height
	--local width = src.DataWindow:Width()
	--local height = src.DataWindow:Height()

	-- Image metadata
	-- Grab the Metadata Lua table from the image input
	local meta = src.Metadata or {}

	meta.Viewer = {}

	-- Set the pitch/yaw/roll metadata
	meta.Viewer.Transform = {}
	meta.Viewer.Transform.Pitch = pitch
	meta.Viewer.Transform.Yaw = yaw
	meta.Viewer.Transform.Roll = roll

	-- Set the image projection metadata
	meta.Viewer.Projection = {}
	if imageProjection == 0 then
		projectionName = "Flat"
	elseif imageProjection == 1 then
		projectionName = "360VR"
		meta.Viewer.Projection.TinyPlanet = TinyPlanet
		meta.Viewer.Zoom = fov
	elseif imageProjection == 2 then
		projectionName = "180VR"
		meta.Viewer.Projection.TinyPlanet = TinyPlanet
		meta.Viewer.Zoom = fov
	elseif imageProjection == 3 then
		projectionName = "Fisheye"
		meta.Viewer.fov = InFieldOfView:GetValue(req).Value
	end
	meta.Viewer.Projection.Name = projectionName

	-- Set the stereo format
	meta.Stereo = {}
	if inputStereo == 0 then
		-- None
		meta.Stereo.Method = ""
	elseif inputStereo == 1 then
		-- None
		meta.Stereo.Method = ""
	elseif inputStereo == 2 then
		-- Horizontal Stack/Stereo 3D Side By Side
		meta.Stereo.Method = "hstack"
	elseif inputStereo == 3 then
		-- Vertical Stack/Stereo 3D Over Under
		meta.Stereo.Method = "vstack"
	else
		-- None
		meta.Stereo.Method = ""
	end

	if imageProjection == 0 then
		-- Flat
		-- Force the updated Metadata Lua table back into the output
		img.Metadata = meta

		-- Return the source image
		return img
	elseif imageProjection == 1 then
		-- 360VR
	elseif imageProjection == 2 then
		-- 180VR
		fov = fov * 2
		src = Image({
			IMG_Like = img,
			IMG_Width = img.Width * 2.0,
			IMG_Height = img.Height,
			IMAT_OriginalWidth = img.OriginalWidth * 2.0,
			IMAT_OriginalHeight = img.OriginalHeight,
			IMG_NoData = req:IsPreCalc()
		})
		src:Fill(Pixel({R = 0, G = 0, B = 0, A = solidAlpha}))
		src:OMerge(img, math.floor(img.Width * 0.5), 0)
	else
		-- All other modes
	end
	-- print("[Image Projection]", imageProjection)

	if (imageProjection == 1 or imageProjection == 2) then
		-- 360VR or 180VR
		local node = DVIPComputeNode(req, "KartaVRViewerReframeKernel", KartaVRViewerReframeKernel, "KartaVRViewerReframeParams", KartaVRViewerReframeParams)

		local params
		lastreqtime = req.Time
		if (lastreqtime ~= req.Time - 1) then
			params = node:GetParamBlock(KartaVRViewerReframeParams)
		end

		local pitch = ((((InCenter:GetValue(req).Y - 0.5) * 180) + domeTiltAngle) * -1) / (180.0 / math.pi)
		local yaw = ((((InCenter:GetValue(req).X - 0.5) * 360) - 90) * (math.pi / 180.0)) + converge
		local roll = (InAngle:GetValue(req).Value * -1.0) * (math.pi / 180.0)
		params.pitch = pitch
		params.yaw = yaw
		params.roll = roll

		params.fov = fov
		params.showST = InOutputSTMap:GetValue(req).Value

		params.projection = imageProjection
		params.isRectilinear = 1 - tinyPlanet
		params.isTinyplanet = tinyPlanet
		params.srcCompOrder = src:IsMask() and 1 or 15

		-- params.srcSize[0] = src.DataWindow:Width()
		-- params.srcSize[1] = src.DataWindow:Height()
		-- params.srcSize[0] = width
		-- params.srcSize[1] = height
		params.srcSize[0] = dst.Width
		params.srcSize[1] = dst.Height

		node:SetParamBlock(params)

		-- Fix edge seam artifacts on tiny planet wide angle outputs
		if edges == 0 then
			node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR,TEX_ADDRESS_MODE_BORDER, TEX_NORMALIZED_COORDS_TRUE)
		elseif edges == 1 then
			node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR,TEX_ADDRESS_MODE_WRAP, TEX_NORMALIZED_COORDS_TRUE)
		elseif edges == 2 then
			node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR,TEX_ADDRESS_MODE_DUPLICATE, TEX_NORMALIZED_COORDS_TRUE)
		elseif edges == 3 then
			node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR,TEX_ADDRESS_MODE_MIRROR, TEX_NORMALIZED_COORDS_TRUE)
		end

		if reset == 1 then
			node:ForceRebuild()
			InReset:SetSource(Number(0), 1)
		end

		node:AddInput("src", src)
		node:AddOutput("dst", dst)

		local ok = node:RunSession(req)
		if not ok then
			dst = nil
			dump(node:GetErrorLog())
		end

		-- Required to be able to post-crop the image
		dst:DownloadGPUMem(req)

		-- Force the updated Metadata Lua table back into the output
		dst.Metadata = meta

		-- Debug test with DCTL disabled
		-- dst = src
	elseif imageProjection == 3 then
		-- Fisheye
		
		-- Create a new DCTL Kernel for DCTL based pixel warping
		local node = DVIPComputeNode(req, "KartaVRViewerFisheyeKernel", KartaVRViewerFisheyeKernel, "KartaVRViewerFisheyeParams", KartaVRViewerFisheyeParams)

		-- Set the last frame rendering request time value to "req.Time"
		local params
		-- DCTL Parameters
		lastreqtime = req.Time
		if (lastreqtime ~= req.Time - 1) then
			params = node:GetParamBlock(KartaVRViewerFisheyeParams)
		end

		params.tilt = pitch
		params.pan = yaw
		params.roll = roll

		params.frameAspect = 2.0
		-- params.frameAspect = dst.Width / dst.Height

		-- Circular vector mask
		local maskCenter = InCircularMaskCenter:GetValue(req)
		params.center[0] = maskCenter.X
		params.center[1] = maskCenter.Y
		params.maskSoftness = math.max(InCircularMaskSoftness:GetValue(req).Value, 0.0001)

		-- Keep the mask feathering effect constrained inside the circular cropping zone
		-- params.maskRadius = InCircularMaskDiameter:GetValue(req).Value
		params.maskRadius = InCircularMaskDiameter:GetValue(req).Value - (params.maskSoftness * 2)
	
		-- Camera lens FoV (Field of View) in degrees
		params.fov = InFieldOfView:GetValue(req).Value
		params.showST = InOutputSTMap:GetValue(req).Value

		-- Rotation axis ordering (PTR)
		params.order = 3

		-- params.srcSize[0] = width
		-- params.srcSize[1] = height
		params.srcSize[0] = dst.Width
		params.srcSize[1] = dst.Height

		node:SetParamBlock(params)

		-- Fix edge seam artifacts on super-wide angle FOV outputs
		if edges == 0 then
			node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR,TEX_ADDRESS_MODE_BORDER, TEX_NORMALIZED_COORDS_TRUE)
		elseif edges == 1 then
			node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR,TEX_ADDRESS_MODE_WRAP, TEX_NORMALIZED_COORDS_TRUE)
		elseif edges == 2 then
			node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR,TEX_ADDRESS_MODE_DUPLICATE, TEX_NORMALIZED_COORDS_TRUE)
		elseif edges == 3 then
			node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR,TEX_ADDRESS_MODE_MIRROR, TEX_NORMALIZED_COORDS_TRUE)
		end

		-- Rebuild the image output
		if reset == 1 then
			node:ForceRebuild()
			InReset:SetSource(Number(0), 1)
		end

		node:AddInput("src", src)
		node:AddOutput("dst", dst)

		local ok = node:RunSession(req)
		if not ok then
			dst = nil
			dump(node:GetErrorLog())
		end

		-- Debug test with DCTL disabled
		--dst = src

		-- Force the updated Metadata Lua table back into the output
		dst.Metadata = meta

		-- Required to be able to post-crop the image
		dst:DownloadGPUMem(req)
	end

	return dst
end

function Process(req)
	local img1 = InImage1:GetValue(req)
	local img2 = InImage2:GetValue(req)

	local w, h = outputSize(req)

	local imageProjection = InImageProjection:GetValue(req).Value
	local inputStereo = InInputStereo:GetValue(req).Value
	local swapEyes = InSwapEyes:GetValue(req).Value
	local anaglyph = InAnaglyph:GetValue(req).Value
	local solidAlpha = InSolidAlpha:GetValue(req).Value
	local left
	local right

	-- Required to pre-crop the image
	img1:DownloadGPUMem(req)

	-- Input Cropping
	if inputStereo == 0 then
		-- Mono
		local dstLeft = processEye(req, img1, 1)

		-- Return the source images
		OutImage1:Set(req, dstLeft)
		return
	elseif inputStereo == 1 then
		-- Dual In
		local dstLeft = processEye(req, img1, 1)
	
		img2:DownloadGPUMem(req)
		img2:Crop(img2, { })
		local dstRight = processEye(req, img2, -1)

		-- Swap the left and right eye views
		if swapEyes == 1 or swapEyes == true then
			dstTmp = dstLeft
			dstLeft = dstRight
			dstRight = dstTmp
		end

		if anaglyph == 1 or anaglyph == true then
			-- Generate a red/cyan anaglyph image
			local dstAnglyph = dstLeft:ChannelOpOf("Copy", dstRight, {R = "Bg.R", G = "Fg.G", B = "Fg.B", A = 1.0})
			dstAnglyph:DownloadGPUMem(req)
			-- Return the images
			OutImage1:Set(req, dstAnglyph)
			OutImage2:Set(req, dstAnglyph)
			return
		else
			-- Return the images
			OutImage1:Set(req, dstLeft)
			OutImage2:Set(req, dstRight)
			collectgarbage()
			return
		end
	elseif inputStereo == 2 then
		-- Horiz
		-- width = width * 0.5
		local left = Image({
			IMG_Like = img1,
			IMG_Width = img1.Width * 0.5,
			IMG_Height = img1.Height,
			IMAT_OriginalWidth = img1.OriginalWidth * 0.5,
			IMAT_OriginalHeight = img1.OriginalHeight,
			IMG_NoData = req:IsPreCalc()
		})
		local right = Image({
			IMG_Like = img1,
			IMG_Width = img1.Width * 0.5,
			IMG_Height = img1.Height,
			IMAT_OriginalWidth = img1.OriginalWidth * 0.5,
			IMAT_OriginalHeight = img1.OriginalHeight,
			IMG_NoData = req:IsPreCalc()
		})

		-- Define the frame cropping parameters
		img1:Crop(left, {
			CROP_XOffset = 0,
			CROP_YOffset = 0,
		})
		img1:Crop(right, {
			CROP_XOffset = math.floor(img1.Width * 0.5),
			CROP_YOffset = 0,
		})

		-- Run the DCTL Kernel
		local dstLeft = processEye(req, left, 1)
		local dstRight = processEye(req, right, -1)

		-- Swap the left and right eye views
		if swapEyes == 1 or swapEyes == true then
			dstTmp = dstLeft
			dstLeft = dstRight
			dstRight = dstTmp
		end

		if anaglyph == 1 or anaglyph == true then
			-- Generate a red/cyan anaglyph image
			local dstAnglyph = dstLeft:ChannelOpOf("Copy", dstRight, {R = "Bg.R", G = "Fg.G", B = "Fg.B", A = 1.0})
			dstAnglyph:DownloadGPUMem(req)

			-- Return the images
			OutImage1:Set(req, dstAnglyph)
			OutImage2:Set(req, dstAnglyph)
			collectgarbage()
			return
		end

		local dstStereo
		if imageProjection == 0 then
			dstStereo = Image({
				IMG_Like = img1,
				IMG_Width = img1.Width,
				IMG_Height = img1.Height,
				IMAT_OriginalWidth = img1.OriginalWidth,
				IMAT_OriginalHeight = img1.OriginalHeight,
				IMG_NoData = req:IsPreCalc()
			})
	
			dstStereo:Fill(Pixel({R = 0, G = 0, B = 0, A = solidAlpha}))
			dstStereo:OMerge(dstLeft, 0, 0)
			dstStereo:OMerge(dstRight, math.floor(img1.Width * 0.5), 0)
		else
			dstStereo = Image({
				IMG_Like = img1,
				IMG_Width = w * 2,
				IMG_Height = h,
				IMAT_OriginalWidth = w * 2,
				IMAT_OriginalHeight = h,
				IMG_NoData = req:IsPreCalc()
			})
	
			dstStereo:Fill(Pixel({R = 0, G = 0, B = 0, A = solidAlpha}))
			dstStereo:OMerge(dstLeft, 0, 0)
			dstStereo:OMerge(dstRight, math.floor(w), 0)
		end
		
		-- Return the images
		OutImage1:Set(req, dstStereo)
		OutImage2:Set(req, dstStereo)
		collectgarbage()
		return
	elseif inputStereo == 3 then
		-- Vert
		-- height = height * 0.5
		local left = Image({
			IMG_Like = img1,
			IMG_Width = img1.Width,
			IMG_Height = img1.Height * 0.5,
			IMAT_OriginalWidth = img1.OriginalWidth,
			IMAT_OriginalHeight = img1.OriginalHeight * 0.5,
			IMG_NoData = req:IsPreCalc()
		})
		local right = Image({
			IMG_Like = img1,
			IMG_Width = img1.Width,
			IMG_Height = img1.Height * 0.5,
			IMAT_OriginalWidth = img1.OriginalWidth,
			IMAT_OriginalHeight = img1.OriginalHeight * 0.5,
			IMG_NoData = req:IsPreCalc()
		})

		-- Define the frame cropping parameters
		img1:Crop(left, {
			CROP_XOffset = 0,
			CROP_YOffset = math.floor(img1.Height * 0.5),
		})
		img1:Crop(right, {
			CROP_XOffset = 0,
			CROP_YOffset = 0,
		})

		-- Run the DCTL Kernel
		local dstLeft = processEye(req, left, 1)
		local dstRight = processEye(req, right, -1)

		-- Swap the left and right eye views
		if swapEyes == 1 or swapEyes == true then
			dstTmp = dstLeft
			dstLeft = dstRight
			dstRight = dstTmp
		end

		if anaglyph == 1 or anaglyph == true then
			-- Generate a red/cyan anaglyph image
			local dstAnglyph = dstLeft:ChannelOpOf("Copy", dstRight, {R = "Bg.R", G = "Fg.G", B = "Fg.B", A = 1.0})
			dstAnglyph:DownloadGPUMem(req)
			-- Return the images
			OutImage1:Set(req, dstAnglyph)
			OutImage2:Set(req, dstAnglyph)
			collectgarbage()
			return
		end

		local dstStereo
		if imageProjection == 0 then
			dstStereo = Image({
				IMG_Like = img1,
				IMG_Width = img1.Width,
				IMG_Height = img1.Height,
				IMAT_OriginalWidth = img1.OriginalWidth,
				IMAT_OriginalHeight = img1.OriginalHeight,
				IMG_NoData = req:IsPreCalc()
			})
	
			dstStereo:Fill(Pixel({R = 0, G = 0, B = 0, A = solidAlpha}))
			dstStereo:OMerge(dstLeft, 0, math.floor(img1.Height * 0.5))
			dstStereo:OMerge(dstRight, 0, 0)
		else
			dstStereo = Image({
				IMG_Like = img1,
				IMG_Width = w,
				IMG_Height = h * 2,
				IMAT_OriginalWidth = w,
				IMAT_OriginalHeight = h * 2,
				IMG_NoData = req:IsPreCalc()
			})
	
			dstStereo:Fill(Pixel({R = 0, G = 0, B = 0, A = solidAlpha}))
			dstStereo:OMerge(dstLeft, 0, math.floor(h))
			dstStereo:OMerge(dstRight, 0, 0)
		end

		-- Return the images
		OutImage1:Set(req, dstStereo)
		OutImage2:Set(req, dstStereo)
		collectgarbage()
		return
	else
		-- Fallback
		local dstLeft = processEye(req, img1, 1)

		-- Return the images
		OutImage1:Set(req, dstLeft)
		OutImage2:Set(req, dstLeft)
		collectgarbage()
		return
	end
end
